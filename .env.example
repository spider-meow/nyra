# RightsWatch — environment variables
#
# These drive the multi-tenant, Supabase-backed mode (backend/rightswatch/
# cloud/) — see docs/ARCHITECTURE.md and supabase/README.md. Presence of
# DATABASE_URL is literally the switch: `rightswatch ui` uses this mode
# automatically when it's set, and stays on the local SQLite + no-accounts
# mode otherwise (see cli.py's `ui` command). Copy this file to `.env` and
# fill it in once a Supabase project exists; never commit the real `.env`
# (see .gitignore).

# --- Supabase — backend only, never sent to the frontend ---

# Postgres connection string. Dashboard: Project Settings > Database >
# Connection string. Supabase offers three variants there — use the
# pooler URI in "Session" mode:
#   postgresql://postgres.<project-ref>:[password]@aws-0-<region>.pooler.supabase.com:5432/postgres
# Session mode behaves like a normal Postgres connection (prepared
# statements etc. work), unlike "Transaction" mode (port 6543), which is
# built for serverless functions cycling through many short-lived
# connections — not our case, the pipeline runs on one dedicated server
# with its own long-lived connection pool. The plain direct connection
# (db.<project-ref>.supabase.co:5432) also works but caps out on
# concurrent connections sooner than going through the pooler.
DATABASE_URL=postgresql://postgres.<project-ref>:[password]@aws-0-<region>.pooler.supabase.com:5432/postgres

# Dashboard: Project Settings > API > Project URL. Used for Storage calls
# and, unless SUPABASE_JWT_SECRET is set (see below), to fetch the
# project's public signing keys to verify user JWTs.
SUPABASE_URL=https://<project-ref>.supabase.co

# Dashboard: Project Settings > API > service_role secret key. Used
# server-side only, by the crawl/match/ingest pipeline to read and write
# Postgres and Storage — it bypasses Row Level Security, so authorization
# for pipeline actions is checked in Python (membership + role) before
# each call, not left to RLS. Treat this like a root password: never log
# it, never expose it to the frontend, rotate it if it ever leaks.
SUPABASE_SERVICE_ROLE_KEY=

# Dashboard: Project Settings > API > JWT Settings. Only set this if that
# page shows a "Legacy JWT Secret" (older projects, HS256) — leave it
# blank if it shows "JWT Signing Keys" instead (newer projects, RS256/
# ES256): the backend then verifies tokens against the project's public
# JWKS automatically, which is the better default when available (no
# shared secret to leak). Either way, verification happens locally in
# the backend, never by calling Supabase's Auth API per request.
SUPABASE_JWT_SECRET=
