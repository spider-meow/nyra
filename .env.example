# Nyra — environment variables, read by `nyra serve`, `nyra worker` and
# the `nyra cloud-*` commands (from the environment or this file copied to
# `.env`). Never commit the real `.env`.

# --- Supabase — backend only, never sent to the frontend ---

# Postgres connection string. Dashboard: Connect > Session pooler:
#   postgresql://postgres.<project-ref>:[password]@aws-0-<region>.pooler.supabase.com:5432/postgres
# Session mode behaves like a normal Postgres connection (prepared
# statements work); the backend keeps its own small connection pool.
# Avoid Transaction mode (port 6543), built for serverless functions.
DATABASE_URL=postgresql://postgres.<project-ref>:[password]@aws-0-<region>.pooler.supabase.com:5432/postgres

# Dashboard: Project Settings > API > Project URL.
SUPABASE_URL=https://<project-ref>.supabase.co

# Dashboard: Project Settings > API > anon / publishable key. Public by
# design: the browser uses it to open a session. The interface reads it
# from GET /api/auth/config.
SUPABASE_ANON_KEY=

# Dashboard: Project Settings > API > service_role key. Server-side only:
# it bypasses Row Level Security. Treat it like a root password; rotate it
# if it ever leaks (including through a synced folder or a screenshot).
SUPABASE_SERVICE_ROLE_KEY=

# Only if Project Settings > API > JWT Settings shows a "Legacy JWT
# Secret" (HS256). Leave blank for the newer signing keys (RS256/ES256):
# tokens are then checked against the project's public keys.
SUPABASE_JWT_SECRET=

# --- Nyra ---

# Public address of the interface, e.g. https://nyra.example.com. Used as
# the landing page of invitation e-mails (`nyra cloud-invite`). Add
# <NYRA_PUBLIC_URL>/connexion and <NYRA_PUBLIC_URL>/mot-de-passe to
# Authentication > URL Configuration > Redirect URLs in Supabase.
NYRA_PUBLIC_URL=

# Worker log level (DEBUG, INFO, WARNING).
NYRA_LOG_LEVEL=INFO
