# RightsWatch — environment variables
#
# Not consumed by any code yet. The backend currently reads its
# configuration from config.yaml + CLI flags and persists to SQLite +
# local disk (see docs/ARCHITECTURE.md) — none of this is wired up.
# This file documents what the backend will need once it's connected to
# the Supabase project described in supabase/ (schema + RLS policies,
# not yet applied to a real project either). Copy to `.env` and fill in
# once that project exists; don't commit the real `.env` (see .gitignore).

# --- Supabase — backend only, never sent to the frontend ---

# Direct Postgres connection string. Dashboard: Project Settings >
# Database > Connection string — use the pooler URI ("Transaction" mode)
# for the backend's connection pool, not the direct connection.
DATABASE_URL=postgresql://postgres:[password]@[host]:[port]/postgres

# Dashboard: Project Settings > API > Project URL.
SUPABASE_URL=https://<project-ref>.supabase.co

# Dashboard: Project Settings > API > anon/public key. Used to verify the
# JWT a logged-in user sends with each request (issued by Supabase Auth
# at login) before looking up their organization/role in `memberships`.
SUPABASE_ANON_KEY=

# Dashboard: Project Settings > API > service_role secret key. Used
# server-side only, by the crawl/match/ingest pipeline to read and write
# Postgres and Storage — it bypasses Row Level Security, so authorization
# for pipeline actions is checked in Python (membership + role) before
# each call, not left to RLS. Treat this like a root password: never log
# it, never expose it to the frontend, rotate it if it ever leaks.
SUPABASE_SERVICE_ROLE_KEY=
