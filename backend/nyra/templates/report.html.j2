{%- macro badge(status) -%}
<span class="badge s-{{ {'expire':'expired','<30j':'urgent','<90j':'soon','ok':'ok','inconnue':'unknown'}[status] }}">{{ status_labels[status] }}</span>
{%- endmacro -%}
{%- macro days(group) -%}
{%- if group.days_left is none -%}Date inconnue
{%- elif group.days_left < 0 -%}Expiré depuis {{ -group.days_left }} j
{%- elif group.days_left == 0 -%}Expire aujourd'hui
{%- else -%}Expire dans {{ group.days_left }} j{%- endif -%}
{%- endmacro -%}
{%- macro line(row) -%}
{%- set group = row.group %}{% set hit = row.hit %}
<article class="line a-{{ row.section }}">
  <div class="pics">
    {% if thumb_class.get(group.ref_thumb) %}<div class="thumb {{ thumb_class[group.ref_thumb] }}" role="img" aria-label="Visuel de la bibliothèque"></div>{% else %}<div class="thumb empty"></div>{% endif %}
    {% if thumb_class.get(hit.site_thumb) %}<div class="thumb {{ thumb_class[hit.site_thumb] }}" role="img" aria-label="Image trouvée sur le site"></div>{% else %}<div class="thumb empty"></div>{% endif %}
  </div>
  <div class="body">
    <h3>{{ group.filename }}</h3>
    {% if row.page %}<a class="page" href="{{ row.page }}">{{ row.page }}</a>{% else %}<span class="muted small">Page non connue</span>{% endif %}
    <p class="state">{{ badge(row.status) }} <span>{{ days(group) }}{% if group.expiry_date %} <span class="muted">· {{ group.expiry_date }}</span>{% endif %}</span></p>
    <p class="muted small presence p-{{ row.presence }}">{{ presence_labels[row.presence] }}{% if row.read_on %} · lu le {{ row.read_on }}{% endif %}{% if row.reason %} · {{ row.reason }}{% endif %}
      · {{ confidence_labels.get(hit.confidence, hit.confidence) }} {{ (hit.score * 100)|round|int }} %{% if hit.decision %} · {{ decision_labels.get(hit.decision, '') }}{% endif %}</p>
    {% if group.credit or group.notes %}<p class="muted small">{{ group.credit }}{% if group.credit and group.notes %} · {% endif %}{{ group.notes }}</p>{% endif %}
  </div>
  <p class="todo t-{{ row.section }}"><span class="muted small">À faire</span>{{ row.action }}</p>
</article>
{%- endmacro -%}
{%- macro block(name, title, empty, folded=false) -%}
{%- set items = sections[name] %}
{%- if folded %}{% if items %}<details class="fold"><summary><h2>{{ title }} <span class="n">{{ items|length }} page{{ 's' if items|length > 1 }}</span></h2></summary>{% for row in items %}{{ line(row) }}{% endfor %}</details>{% endif %}
{%- else %}<section><h2>{{ title }} <span class="n">{{ items|length }} page{{ 's' if items|length > 1 }}</span></h2>{% for row in items %}{{ line(row) }}{% else %}<p class="empty-note">{{ empty }}</p>{% endfor %}</section>{% endif %}
{%- endmacro -%}
<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Rapport Nyra{% if organization %} · {{ organization }}{% endif %}</title>
<style>
  :root {
    --ink: #111; --muted: #5f5f5f; --line: #e3e3e3; --soft: #f6f6f5;
    --expired: #b42318; --urgent: #c4460a; --soon: #8a6a00; --ok: #1f7a3a; --unknown: #5f5f5f;
  }
  * { box-sizing: border-box; }
  body { margin: 0; padding: 40px 48px; font: 14px/1.45 -apple-system, "Segoe UI", Roboto, Arial, sans-serif; color: var(--ink); background: #fff; }
  .top { display: flex; justify-content: space-between; align-items: flex-end; border-bottom: 2px solid var(--ink); padding-bottom: 16px; }
  .brand { font-size: 13px; font-weight: 600; letter-spacing: .08em; text-transform: uppercase; }
  h1 { font-size: 28px; margin: 6px 0 0; letter-spacing: -.02em; }
  .muted { color: var(--muted); }
  .small { font-size: 12px; }
  .tiles { display: grid; grid-template-columns: repeat(4, 1fr); gap: 12px; margin: 24px 0 8px; }
  .tile { border: 1px solid var(--line); border-radius: 10px; padding: 14px 16px; }
  .tile strong { display: block; font-size: 26px; letter-spacing: -.02em; }
  .tile.alert strong { color: var(--expired); }
  h2 { font-size: 18px; margin: 36px 0 4px; }
  h2 + p { margin: 0 0 14px; }
  .n { font-size: 13px; font-weight: 600; color: var(--muted); }
  .line { display: grid; grid-template-columns: 148px 1fr 150px; gap: 16px; align-items: start; padding: 14px; border: 1px solid var(--line); border-left: 4px solid var(--line); border-radius: 10px; margin: 0 0 10px; break-inside: avoid; }
  .line.a-remove { border-left-color: var(--expired); } .line.a-soon { border-left-color: var(--urgent); } .line.a-check { border-left-color: var(--soon); }
  .pics { display: flex; gap: 8px; }
  .body h3 { margin: 0 0 3px; font-size: 15px; word-break: break-all; }
  .body p { margin: 4px 0 0; }
  .state { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; }
  .todo { margin: 0; display: flex; flex-direction: column; gap: 2px; font-weight: 600; font-size: 14px; text-align: right; }
  .t-remove { color: var(--expired); } .t-soon { color: var(--urgent); } .t-check { color: var(--soon); }
  .p-still { color: var(--expired); } .p-gone { color: var(--ok); }
  .thumb { background-size: cover; background-position: center; -webkit-print-color-adjust: exact; print-color-adjust: exact; flex: none; width: 70px; height: 70px; object-fit: cover; border-radius: 8px; border: 1px solid var(--line); display: block; background: #fff; }
  .thumb.sm { width: 56px; height: 56px; }
  .thumb.empty { background: var(--line); }
  .fold > summary { cursor: pointer; list-style: none; } .fold > summary h2 { display: inline-block; } .fold > summary h2::before { content: '▸ '; } .fold[open] > summary h2::before { content: '▾ '; }
  .warn { border: 1px solid var(--soon); border-radius: 10px; padding: 10px 14px; margin: 16px 0 0; color: var(--soon); font-weight: 600; }
  table { width: 100%; border-collapse: collapse; }
  th, td { text-align: left; vertical-align: top; padding: 10px 14px; border-top: 1px solid var(--line); }
  th { font-size: 11px; text-transform: uppercase; letter-spacing: .05em; color: var(--muted); font-weight: 600; }
  .c-img { width: 84px; }
  a { color: inherit; }
  a.page { display: block; font-size: 12px; color: var(--muted); word-break: break-all; }
  .badge { display: inline-block; padding: 2px 9px; border-radius: 999px; font-size: 11px; font-weight: 600; border: 1px solid currentColor; }
  .s-expired { color: var(--expired); } .s-urgent { color: var(--urgent); } .s-soon { color: var(--soon); }
  .s-ok { color: var(--ok); } .s-unknown { color: var(--unknown); }
  .nf { width: 100%; border: 1px solid var(--line); border-radius: 12px; overflow: hidden; }
  .nf td { vertical-align: middle; }
  .empty-note { color: var(--muted); font-style: italic; padding: 8px 0; }
  footer { margin-top: 40px; padding-top: 14px; border-top: 1px solid var(--line); font-size: 12px; color: var(--muted); }
  @media (max-width: 720px) { body { padding: 20px 16px; } .tiles { grid-template-columns: repeat(2, 1fr); } .line { grid-template-columns: 1fr; } .todo { text-align: left; } }
  @media print {
    body { padding: 0; font-size: 12px; }
    @page { margin: 14mm; }
    a { text-decoration: none; }
    .line, .tile { break-inside: avoid; }
  }
  {{ thumb_css }}
</style>
</head>
<body>
  <div class="top">
    <div>
      <div class="brand">Nyra{% if organization %} · {{ organization }}{% endif %}</div>
      <h1>Visuels sous droits trouvés en ligne</h1>
    </div>
    <div class="muted small" style="text-align:right">
      Généré le {{ generated_at }}<br>
      Fenêtre : expirés ou expirant sous {{ within_days }} jours
    </div>
  </div>

  <div class="tiles">
    <div class="tile{{ ' alert' if summary.expired_online }}"><strong>{{ summary.expired_online }}</strong>visuel{{ 's' if summary.expired_online != 1 }} expiré{{ 's' if summary.expired_online != 1 }} encore en ligne</div>
    <div class="tile"><strong>{{ summary.urgent_online }}</strong>expire{{ 'nt' if summary.urgent_online != 1 }} sous 30 jours</div>
    <div class="tile"><strong>{{ summary.to_verify }}</strong>à vérifier</div>
    <div class="tile"><strong>{{ summary.not_found }}</strong>non trouvé{{ 's' if summary.not_found != 1 }}</div>
  </div>
  <p class="muted small">{{ stats.get('reference_images', 0) }} références comparées à {{ stats.get('site_images', 0) }} images lues sur {{ stats.get('pages_crawled', 0) }} pages. Les occurrences marquées « faux positif » ne figurent pas dans ce rapport.</p>

  {% if suspect_sites %}<p class="warn">La dernière lecture de {{ suspect_sites|join(', ') }} semble incomplète : aucun visuel n'est marqué retiré.</p>{% endif %}
  {{ block('remove', 'À retirer maintenant', "Rien d'expiré en ligne.") }}
  {{ block('soon', 'Expirent bientôt', "Aucun visuel en ligne n'expire dans les 90 jours.") }}
  {{ block('check', 'À vérifier', "Rien à vérifier.") }}
  {{ block('done', 'Déjà retirés ou remplacés', '', true) }}
  {{ block('other', 'Droits en règle ou sans date', '', true) }}

  {% for done, title in ((true, 'Non trouvés : comparés, rien trouvé'), (false, 'Non trouvés : pas encore comparés')) %}
  {% set items = not_found|selectattr('compared', 'equalto', done)|list %}
  <h2>{{ title }} <span class="n">{{ items|length }}</span></h2>
  {% if items %}
  <table class="nf">
    <thead><tr><th class="c-img"></th><th>Référence</th><th>Échéance</th></tr></thead>
    <tbody>
    {% for item in items %}
      <tr>
        <td class="c-img">{% if thumb_class.get(item.ref_thumb) %}<div class="thumb sm {{ thumb_class[item.ref_thumb] }}"></div>{% endif %}</td>
        <td>{{ item.filename }}{% if item.credit %}<div class="muted small">{{ item.credit }}</div>{% endif %}</td>
        <td>{{ badge(item.status) }} <span class="muted small">{{ days(item) }}</span></td>
      </tr>
    {% endfor %}
    </tbody>
  </table>
  {% else %}<p class="empty-note">{{ 'Toutes les références ont au moins une occurrence ou ne sont pas encore comparées.' if done else 'Toutes les références ont été comparées.' }}</p>{% endif %}
  {% endfor %}

  <footer>Réglages de détection : {{ settings }}. Sites lus : {{ site_read_on or "date inconnue" }}.<br>Rapport produit par Nyra. Détection automatique par empreinte perceptuelle et similarité visuelle ; les correspondances « à vérifier » demandent une confirmation humaine.</footer>
</body>
</html>
