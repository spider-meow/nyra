{%- macro badge(status) -%}
<span class="badge s-{{ {'expire':'expired','<30j':'urgent','<90j':'soon','ok':'ok','inconnue':'unknown'}[status] }}">{{ status_labels[status] }}</span>
{%- endmacro -%}
{%- macro days(group) -%}
{%- if group.days_left is none -%}Date inconnue
{%- elif group.days_left < 0 -%}Expiré depuis {{ -group.days_left }} j
{%- elif group.days_left == 0 -%}Expire aujourd'hui
{%- else -%}Expire dans {{ group.days_left }} j{%- endif -%}
{%- endmacro -%}
{%- macro line(row) -%}
{%- set group = row.group %}{% set hit = row.hit %}
<article class="line a-{{ row.section }}">
  <div class="pics">
    {% if thumb_class.get(group.ref_thumb) %}<figure><div class="thumb {{ thumb_class[group.ref_thumb] }}" role="img" aria-label="Visuel de la bibliothèque"></div><figcaption>Bibliothèque</figcaption></figure>{% else %}<figure><div class="thumb"></div><figcaption>Bibliothèque</figcaption></figure>{% endif %}
    {% if thumb_class.get(hit.site_thumb) %}<figure><div class="thumb {{ thumb_class[hit.site_thumb] }}" role="img" aria-label="Image trouvée sur le site"></div><figcaption>Sur le site</figcaption></figure>{% else %}<figure><div class="thumb"></div><figcaption>Sur le site</figcaption></figure>{% endif %}
  </div>
  <div class="what">
    <h3>{{ group.filename }}</h3>
    <p class="on"><span>Sur la page</span>{% if row.page %}<a href="{{ row.page }}">{{ row.page|replace('https://', '')|replace('http://', '') }}</a>{% else %}<em>page non connue</em>{% endif %}</p>
    {% if group.credit or group.notes %}<span class="note">{{ group.credit }}{% if group.credit and group.notes %} · {% endif %}{{ group.notes }}</span>{% endif %}
  </div>
  <div class="when">
    {{ badge(row.status) }}
    <span class="days">{{ days(group) }}</span>
    {% if group.expiry_date %}<span class="date">{{ group.expiry_date }}</span>{% endif %}
  </div>
  <div class="where p-{{ row.presence }}">
    <span class="dot"></span>{{ presence_labels[row.presence] }}
    <span class="date">{% if row.read_on %}lu le {{ row.read_on }}{% endif %}{% if row.reason %}{{ ' · ' if row.read_on }}{{ row.reason }}{% endif %}</span>
    <span class="date">{{ confidence_labels.get(hit.confidence, hit.confidence) }} {{ (hit.score * 100)|round|int }} %{% if hit.decision %} · {{ decision_labels.get(hit.decision, '') }}{% endif %}</span>
  </div>
  <div class="todo"><span class="pill t-{{ row.section }}">{{ row.action }}</span></div>
</article>
{%- endmacro -%}
{%- macro block(name, title, empty, folded=false) -%}
{%- set items = sections[name] %}
{%- if folded %}{% if items %}<details class="fold"><summary><h2>{{ title }}</h2><span class="n">{{ items|length }} page{{ 's' if items|length > 1 }}</span></summary><div class="list">{% for row in items %}{{ line(row) }}{% endfor %}</div></details>{% endif %}
{%- else %}<section><div class="sh"><h2>{{ title }}</h2><span class="n">{{ items|length }} page{{ 's' if items|length > 1 }}</span></div><div class="list">{% for row in items %}{{ line(row) }}{% else %}<p class="empty-note">{{ empty }}</p>{% endfor %}</div></section>{% endif %}
{%- endmacro -%}
<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Rapport Nyra{% if organization %} · {{ organization }}{% endif %}</title>
<style>
  :root {
    --ink: #1a3300; --ink-soft: #3d5226; --muted: #5f6e50; --faint: #8a9680; --line: #ebe7db; --canvas: #fdfcf8; --sunk: #f7f4ec;
    --yellow: #f6e27f; --expired: #a8261b; --urgent: #a34e0c; --soon: #7d6200; --ok: #2f6b45; --unknown: #5f6e50; --terracotta: #cb5521;
    --display: "Bricolage Grotesque", "Segoe UI", system-ui, sans-serif; --mono: "Geist Mono", ui-monospace, SFMono-Regular, Menlo, monospace;
  }
  * { box-sizing: border-box; }
  body { margin: 0; padding: 56px 64px 48px; max-width: 1180px; margin-inline: auto; font: 14px/1.5 Inter, "Segoe UI", system-ui, sans-serif; color: var(--ink); background: var(--canvas); -webkit-font-smoothing: antialiased; }
  .muted { color: var(--muted); } .small { font-size: 12px; }
  a { color: inherit; }

  .top { display: flex; justify-content: space-between; align-items: baseline; gap: 24px; font-size: 12px; color: var(--muted); }
  .brand { font: 700 20px var(--display); color: var(--ink); letter-spacing: -.01em; }
  .brand span { font: 400 13px Inter, system-ui, sans-serif; color: var(--muted); margin-left: 8px; }

  .verdict { margin: 44px 0 36px; max-width: 760px; }
  .verdict h1 { font: 700 44px/1.08 var(--display); letter-spacing: -.025em; margin: 0; }
  .verdict h1 mark { background: linear-gradient(transparent 58%, var(--yellow) 58%); color: inherit; padding: 0 .08em; }
  .verdict p { margin: 14px 0 0; font-size: 15px; color: var(--ink-soft); }

  .figures { display: grid; grid-template-columns: repeat(3, 1fr); border-top: 1px solid var(--ink); border-bottom: 1px solid var(--line); }
  .fig { padding: 20px 24px 20px 0; } .fig + .fig { padding-left: 24px; border-left: 1px solid var(--line); }
  .fig strong { display: block; font: 700 40px/1 var(--display); letter-spacing: -.03em; }
  .fig.alert strong { color: var(--terracotta); }
  .fig span { display: block; margin-top: 8px; font-size: 13px; color: var(--muted); }
  .scope { margin: 14px 0 0; font-size: 12px; color: var(--faint); }

  .warn { display: flex; gap: 10px; align-items: baseline; margin: 28px 0 0; padding: 12px 16px; background: rgb(246 226 127 / .45); border-radius: 10px; font-weight: 500; }
  .warn::before { content: "!"; flex: none; width: 20px; height: 20px; border-radius: 50%; background: var(--ink); color: var(--yellow); font: 700 12px/20px var(--display); text-align: center; }

  section, .fold { margin-top: 52px; }
  .sh, .fold > summary { display: flex; align-items: baseline; gap: 14px; padding-bottom: 12px; border-bottom: 1px solid var(--ink); }
  h2 { font: 700 22px/1.2 var(--display); letter-spacing: -.015em; margin: 0; }
  .n { font-size: 12px; color: var(--muted); font-variant-numeric: tabular-nums; }
  .fold > summary { cursor: pointer; list-style: none; } .fold > summary::-webkit-details-marker { display: none; }
  .fold > summary::before { content: "+"; font: 700 20px/1 var(--display); width: 16px; } .fold[open] > summary::before { content: "−"; }

  .line { display: grid; grid-template-columns: 124px minmax(0, 1.7fr) minmax(0, .9fr) minmax(0, 1fr) 128px; gap: 20px; align-items: center; padding: 14px 0; border-bottom: 1px solid var(--line); break-inside: avoid; }
  .pics { display: flex; gap: 6px; }
  .thumb { flex: none; width: 56px; height: 56px; border-radius: 8px; background-color: var(--sunk); background-size: cover; background-position: center; box-shadow: inset 0 0 0 1px rgb(26 51 0 / .08); -webkit-print-color-adjust: exact; print-color-adjust: exact; }
  .thumb.sm { width: 44px; height: 44px; }
  figure { margin: 0; } figcaption { margin-top: 4px; font-size: 9px; letter-spacing: .04em; text-transform: uppercase; color: var(--faint); text-align: center; white-space: nowrap; }
  .what h3 { margin: 0; font-size: 14px; font-weight: 600; word-break: break-all; }
  .note { display: block; margin-top: 2px; font-size: 12px; color: var(--muted); }
  .on { margin: 4px 0 0; font-size: 13px; line-height: 1.35; word-break: break-all; }
  .on span { display: block; font-size: 11px; font-weight: 600; letter-spacing: .05em; text-transform: uppercase; color: var(--faint); }
  .on a { font-weight: 500; text-decoration: underline; text-decoration-color: var(--line); text-underline-offset: 3px; } .on a:hover { text-decoration-color: var(--ink); }
  .on em { color: var(--muted); }
  .when, .where { display: flex; flex-direction: column; gap: 3px; align-items: flex-start; }
  .days { font-weight: 600; } .date { font-size: 12px; color: var(--muted); }
  .where { font-weight: 500; }
  .where .dot { display: inline-block; width: 8px; height: 8px; border-radius: 50%; margin-right: 7px; background: var(--faint); }
  .where { position: relative; } .where .dot { position: absolute; left: 0; top: 7px; } .where { padding-left: 15px; }
  .p-still .dot { background: var(--terracotta); } .p-gone .dot { background: var(--ok); }
  .todo { text-align: right; }
  .pill { display: inline-block; padding: 6px 12px; border-radius: 999px; font-size: 12px; font-weight: 600; white-space: nowrap; border: 1px solid var(--line); }
  .t-remove { background: var(--ink); color: var(--yellow); border-color: var(--ink); }
  .t-soon { background: rgb(246 226 127 / .55); border-color: transparent; }
  .t-check { border: 1px dashed var(--soon); color: var(--soon); }
  .t-other { color: var(--muted); background: var(--sunk); border-color: transparent; font-weight: 500; }

  .badge { display: inline-flex; align-items: center; gap: 6px; padding: 2px 9px; border-radius: 999px; font-size: 11px; font-weight: 600; }
  .badge::before { content: ""; width: 6px; height: 6px; border-radius: 50%; background: currentColor; }
  .s-expired { color: var(--expired); background: #fbe7e3; } .s-urgent { color: var(--urgent); background: #fcebdb; } .s-soon { color: var(--soon); background: #f8f0d2; }
  .s-ok { color: var(--ok); background: #e4f0e7; } .s-unknown { color: var(--unknown); background: #efede4; }

  .empty-note { margin: 0; padding: 22px 0; color: var(--muted); border-bottom: 1px solid var(--line); }

  footer { margin-top: 64px; padding-top: 16px; border-top: 1px solid var(--line); font-size: 12px; color: var(--faint); max-width: 820px; }

  @media (max-width: 900px) {
    body { padding: 28px 18px; } .verdict h1 { font-size: 32px; }
    .figures { grid-template-columns: repeat(2, 1fr); } .fig:nth-child(3) { padding-left: 0; border-left: 0; } .fig:nth-child(n+3) { border-top: 1px solid var(--line); }
    .line { grid-template-columns: auto 1fr; row-gap: 10px; } .when, .where, .todo { grid-column: 2; text-align: left; } .todo { grid-row: 1; grid-column: 1 / -1; }
  }
  @media print {
    body { padding: 0; font-size: 12px; background: #fff; max-width: none; } @page { margin: 14mm; }
    a { text-decoration: none; } .line, .fig { break-inside: avoid; } section, .fold { margin-top: 30px; }
    .verdict h1 { font-size: 34px; }
  }
  {{ thumb_css }}
</style>
</head>
<body>
  <div class="top">
    <div class="brand">Nyra<span>{{ organization }}</span></div>
    <div>Généré le {{ generated_at }}{% if within_days < 3650 %} · échéances sous {{ within_days }} jours{% endif %}</div>
  </div>

  <header class="verdict">
    <h1>{% if summary.expired_online %}<mark>{{ summary.expired_online }} visuel{{ 's' if summary.expired_online != 1 }} expiré{{ 's' if summary.expired_online != 1 }}</mark> encore en ligne.{% else %}Aucun visuel expiré en ligne.{% endif %}</h1>
    <p>{% if summary.urgent_online %}{{ summary.urgent_online }} autre{{ 's' if summary.urgent_online != 1 }} expire{{ 'nt' if summary.urgent_online != 1 }} sous 30 jours. {% endif %}{% if site_read_on %}Sites lus {{ site_read_on }}.{% else %}Date de lecture des sites inconnue.{% endif %}</p>
  </header>

  <div class="figures">
    <div class="fig{{ ' alert' if summary.expired_online }}"><strong>{{ summary.expired_online }}</strong><span>expiré{{ 's' if summary.expired_online != 1 }} en ligne</span></div>
    <div class="fig"><strong>{{ summary.urgent_online }}</strong><span>expire{{ 'nt' if summary.urgent_online != 1 }} sous 30 jours</span></div>
    <div class="fig"><strong>{{ summary.to_verify }}</strong><span>à vérifier</span></div>
  </div>
  <p class="scope">{{ stats.get('reference_images', 0) }} références comparées à {{ stats.get('site_images', 0) }} images lues sur {{ stats.get('pages_crawled', 0) }} pages. Les occurrences marquées « faux positif » ne figurent pas dans ce rapport.</p>

  {% if suspect_sites %}<p class="warn">La dernière lecture de {{ suspect_sites|join(', ') }} semble incomplète : aucun visuel n'est marqué retiré.</p>{% endif %}
  {{ block('remove', 'À retirer maintenant', "Rien d'expiré en ligne.") }}
  {{ block('soon', 'Expirent bientôt', "Aucun visuel en ligne n'expire dans les 90 jours.") }}
  {{ block('check', 'À vérifier', "Rien à vérifier.") }}
  {{ block('other', 'Droits en règle ou sans date', '', true) }}

  <footer>Réglages de détection : {{ settings }}. Sites lus : {{ site_read_on or "date inconnue" }}.<br>Rapport produit par Nyra. Détection automatique par empreinte perceptuelle et similarité visuelle ; les correspondances « à vérifier » demandent une confirmation humaine.</footer>
</body>
</html>
