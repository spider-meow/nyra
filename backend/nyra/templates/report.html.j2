{%- macro days(group) -%}
{%- if group.days_left is none -%}{{ t('date_unknown') }}
{%- elif group.days_left < 0 -%}{{ t('expired_since', n=-group.days_left) }}
{%- elif group.days_left == 0 -%}{{ t('expires_today') }}
{%- else -%}{{ t('expires_in', n=group.days_left) }}{%- endif -%}
{%- endmacro -%}
{%- macro pic(key, label) -%}<div class="thumb {{ thumb_class.get(key, '') }}" role="img" aria-label="{{ label }}"></div>{%- endmacro -%}
{%- macro tile(row) -%}
{%- set group = row.group %}{% set hit = row.hit %}
<figure class="tile k-{{ row.section }}">
  {{ pic(hit.site_thumb if thumb_class.get(hit.site_thumb) else group.ref_thumb, group.filename) }}
  <figcaption><b>{{ group.filename }}</b>{% if row.also %}<span class="note">{{ t('also', n=row.also) }}</span>{% endif %}
    <span class="st">{% if row.section == 'check' %}{{ t('to_check_score', n=(hit.score * 100)|round|int) }}{% else %}{{ days(group) }}{% endif %}</span>
    {% if row.presence == 'unknown' %}<span class="note">{{ t(row.reason) if row.reason else t('not_read_again') }}</span>{% endif %}
    {% if group.credit %}<span class="note">{{ group.credit }}</span>{% endif %}
  </figcaption>
</figure>
{%- endmacro -%}
{%- macro unref(item) -%}
<figure class="tile k-unref">{{ pic(item.thumb, item.name) }}<figcaption><b>{{ item.name }}</b><span class="st">{% if item.page %}{{ t('not_in_library') }}{% else %}{{ t('on_pages', n=item.page_count) }}{% endif %}</span></figcaption></figure>
{%- endmacro -%}
{%- macro counts(r) -%}
{%- set parts = [] -%}
{%- if r.remove %}{% set _ = parts.append(t('n_remove', n=r.remove)) %}{% endif -%}
{%- if r.soon %}{% set _ = parts.append(t('n_soon', n=r.soon)) %}{% endif -%}
{%- if r.check %}{% set _ = parts.append(t('n_check', n=r.check)) %}{% endif -%}
{%- if r.unreferenced %}{% set _ = parts.append(t('n_unref', n=r.unreferenced)) %}{% endif -%}
{{ parts|join(' · ') }}
{%- endmacro -%}
{%- macro place(name) -%}{{ t('home') if name == '/' else t(name) }}{%- endmacro -%}
{%- macro pageno(anchor) -%}{% if for_print %}<td class="pn" data-page="{{ anchor }}">p. –</td>{% endif %}{%- endmacro -%}
<!DOCTYPE html>
<html lang="{{ lang }}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ t('title') }}{% if organization %} · {{ organization }}{% endif %}</title>
<style>
  :root {
    --ink: #1a3300; --ink-soft: #3d5226; --muted: #5f6e50; --faint: #8a9680; --line: #ebe7db; --canvas: #fdfcf8; --sunk: #f7f4ec;
    --yellow: #f6e27f; --expired: #a8261b; --urgent: #a34e0c; --soon: #7d6200; --ok: #2f6b45; --unref: #2d5a8a; --terracotta: #cb5521;
    --display: "Bricolage Grotesque", "Segoe UI", system-ui, sans-serif;
  }
  * { box-sizing: border-box; }
  body { margin: 0 auto; padding: 56px 64px 48px; max-width: 1180px; font: 14px/1.5 Inter, "Segoe UI", system-ui, sans-serif; color: var(--ink); background: var(--canvas); -webkit-font-smoothing: antialiased; }
  a { color: inherit; }
  .top { display: flex; justify-content: space-between; align-items: baseline; gap: 24px; font-size: 12px; color: var(--muted); }
  .brand { font: 700 20px var(--display); color: var(--ink); letter-spacing: -.01em; }
  .brand span { font: 400 13px Inter, system-ui, sans-serif; color: var(--muted); margin-left: 8px; }

  .verdict { margin: 40px 0 28px; max-width: 760px; }
  .verdict h1 { font: 700 40px/1.08 var(--display); letter-spacing: -.025em; margin: 0; }
  .verdict h1 mark { background: linear-gradient(transparent 58%, var(--yellow) 58%); color: inherit; padding: 0 .08em; }
  .verdict p { margin: 12px 0 0; font-size: 15px; color: var(--ink-soft); }

  .figures { display: grid; grid-template-columns: repeat(auto-fit, minmax(130px, 1fr)); border-top: 1px solid var(--ink); border-bottom: 1px solid var(--line); }
  .fig { padding: 18px 20px 18px 0; } .fig + .fig { padding-left: 20px; border-left: 1px solid var(--line); }
  .fig strong { display: block; font: 700 36px/1 var(--display); letter-spacing: -.03em; }
  .fig.alert strong { color: var(--expired); } .fig.unref strong { color: var(--unref); }
  .fig span { display: block; margin-top: 8px; font-size: 13px; color: var(--muted); }
  .scope { margin: 12px 0 0; font-size: 12px; color: var(--faint); }
  .warn { display: flex; gap: 10px; align-items: baseline; margin: 24px 0 0; padding: 12px 16px; background: rgb(246 226 127 / .45); border-radius: 10px; font-weight: 500; }
  .warn::before { content: "!"; flex: none; width: 20px; height: 20px; border-radius: 50%; background: var(--ink); color: var(--yellow); font: 700 12px/20px var(--display); text-align: center; }

  h2 { font: 700 22px/1.2 var(--display); letter-spacing: -.015em; margin: 0; }
  .toc { margin-top: 36px; }
  .toc h2 { font-size: 17px; padding-bottom: 8px; }
  table { width: 100%; border-collapse: collapse; font-size: 13px; }
  th { text-align: left; font-weight: 600; color: var(--muted); font-size: 12px; padding: 6px 8px 6px 0; border-bottom: 1px solid var(--ink); }
  td { padding: 6px 8px 6px 0; border-bottom: 1px solid var(--line); }
  td.n, th.n, td.pn { text-align: right; font-variant-numeric: tabular-nums; white-space: nowrap; }
  td.pn { color: var(--muted); }
  td a { text-decoration: none; } td a:hover { text-decoration: underline; }
  td.n.hot { color: var(--expired); font-weight: 600; } .zero { color: #d7d2c2; }
  .ver-tag { font-weight: 600; margin-right: 6px; }

  .version { margin-top: 56px; }
  .vh { display: flex; flex-wrap: wrap; align-items: baseline; gap: 4px 14px; padding: 14px 18px; background: var(--ink); color: var(--yellow); border-radius: 12px; -webkit-print-color-adjust: exact; print-color-adjust: exact; }
  .vh h2 { color: var(--yellow); } .vh span { color: #e8ecd9; font-size: 13px; word-break: break-all; }
  .rubric { margin-top: 28px; }
  .rh { display: flex; flex-wrap: wrap; align-items: baseline; gap: 4px 14px; padding-bottom: 8px; border-bottom: 2px solid var(--ink); break-after: avoid; }
  .rh h3 { font: 700 20px/1.2 var(--display); letter-spacing: -.01em; margin: 0; }
  .rh span { font-size: 12px; color: var(--muted); }
  .pg { padding: 12px 0 14px; border-bottom: 1px solid var(--line); break-inside: avoid; }
  .pg header { display: flex; justify-content: space-between; gap: 16px; font-size: 13px; }
  .pg header a { font-weight: 600; word-break: break-all; text-decoration: underline; text-decoration-color: var(--line); text-underline-offset: 3px; }
  .pg header span { color: var(--faint); white-space: nowrap; }
  .tiles { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 8px; }
  .tile { margin: 0; width: 104px; font-size: 11px; line-height: 1.3; }
  .tile b { display: block; margin-top: 4px; font-weight: 600; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .tile .st, .tile .note { display: block; } .tile .note { color: var(--faint); }
  .thumb { width: 104px; height: 104px; border-radius: 8px; background-color: var(--sunk); background-size: cover; background-position: center; box-shadow: inset 0 0 0 1px rgb(26 51 0 / .08); -webkit-print-color-adjust: exact; print-color-adjust: exact; }
  .k-remove .thumb { box-shadow: inset 0 0 0 3px var(--expired); } .k-remove .st { color: var(--expired); font-weight: 600; }
  .k-soon .st { color: var(--urgent); font-weight: 600; }
  .k-check .thumb { box-shadow: inset 0 0 0 2px var(--soon); } .k-check .st { color: var(--soon); }
  .k-unref .thumb { outline: 2px dashed var(--unref); outline-offset: -2px; } .k-unref .st { color: var(--unref); }
  .everywhere { margin-top: 20px; padding: 14px 16px; background: var(--sunk); border-radius: 12px; break-inside: avoid; -webkit-print-color-adjust: exact; print-color-adjust: exact; }
  .everywhere p { margin: 0; font-size: 13px; color: var(--ink-soft); }
  .empty-note { margin: 28px 0 0; padding: 22px 0; color: var(--muted); border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); }
  .rh { position: relative; } .rh .mk { position: absolute; left: 0; top: 0; font-size: 1px; line-height: 1px; color: #fff; }
  footer { margin-top: 56px; padding-top: 16px; border-top: 1px solid var(--line); font-size: 12px; color: var(--faint); max-width: 820px; }

  @media (max-width: 900px) {
    body { padding: 28px 18px; } .verdict h1 { font-size: 30px; }
    .tile, .thumb { width: 88px; } .thumb { height: 88px; }
  }
  @media print {
    body { padding: 0; font-size: 11px; background: #fff; max-width: none; }
    a { text-decoration: none; }
    .verdict { margin-top: 24px; } .verdict h1 { font-size: 30px; }
    .toc tr { break-inside: avoid; }
    .version { margin-top: 0; break-before: page; }
    .rubric { margin-top: 18px; }
    .tile { width: 84px; font-size: 9px; } .thumb { width: 84px; height: 84px; }
  }
  {{ thumb_css }}
</style>
</head>
<body>
  <div class="top">
    <div class="brand">Nyra<span>{{ organization }}</span></div>
    <div>{{ t('generated', date=generated_on, time=generated_time) }}{% if scope %} · {{ scope|join(', ') }}{% endif %}{% if within_days < 3650 %} · {{ t('deadlines', n=within_days) }}{% endif %}</div>
  </div>

  <header class="verdict">
    <h1>{% if 'expired' in include %}{% if summary.expired_online %}<mark>{{ t('expired_visuals', n=summary.expired_online) }}</mark> {{ t('still_online') }}{% else %}{{ t('no_expired') }}{% endif %}
      {%- elif 'unreferenced' in include and summary.unreferenced %}<mark>{{ t('n_images', n=summary.unreferenced) }}</mark> {{ t('missing_from_library', n=summary.unreferenced) }}
      {%- else %}{{ t('pages_to_look', n=summary.pages) }}{% endif %}</h1>
    <p>{{ t('lead', n=summary.pages) }} {% if site_read_on %}{{ t('sites_read', when=site_read_on) }}{% else %}{{ t('read_unknown') }}{% endif %}</p>
  </header>

  <div class="figures">
    {% if 'expired' in include %}<div class="fig{{ ' alert' if summary.expired_online }}"><strong>{{ summary.expired_online }}</strong><span>{{ t('fig_expired', n=summary.expired_online) }}</span></div>{% endif %}
    {% if 'soon' in include %}<div class="fig"><strong>{{ summary.soon_online }}</strong><span>{{ t('fig_soon', n=summary.soon_online) }}</span></div>{% endif %}
    {% if 'check' in include %}<div class="fig"><strong>{{ summary.to_verify }}</strong><span>{{ t('fig_check') }}</span></div>{% endif %}
    {% if 'unreferenced' in include %}<div class="fig unref"><strong>{{ summary.unreferenced }}</strong><span>{{ t('fig_unref', n=summary.unreferenced) }}</span></div>{% endif %}
    <div class="fig"><strong>{{ summary.pages }}</strong><span>{{ t('fig_pages', n=summary.pages) }}</span></div>
  </div>
  <p class="scope">{{ t('scope', refs=stats.get('reference_images', 0), images=stats.get('site_images', 0), pages=stats.get('pages_crawled', 0)) }}</p>
  {% if suspect_sites %}<p class="warn">{{ t('suspect', sites=suspect_sites|join(', ')) }}</p>{% endif %}

  {% if priorities %}
  <section class="toc"><h2>{{ t('first') }}</h2>
    <table><thead><tr><th>{{ t('col_place') }}</th><th class="n">{{ t('col_remove') }}</th><th class="n">{{ t('col_soon') }}</th>{% if for_print %}<th class="n">{{ t('col_page') }}</th>{% endif %}</tr></thead><tbody>
    {% for r in priorities %}<tr><td><a href="#{{ r.anchor }}"><span class="ver-tag">{{ r.version }}</span>{{ place(r.name) }}</a></td><td class="n{{ ' hot' if r.remove }}">{{ r.remove or '' }}{% if not r.remove %}<span class="zero">0</span>{% endif %}</td><td class="n">{{ r.soon or '' }}{% if not r.soon %}<span class="zero">0</span>{% endif %}</td>{{ pageno(r.anchor) }}</tr>{% endfor %}
    </tbody></table>
  </section>
  {% endif %}

  {% if versions %}
  <section class="toc"><h2>{{ t('contents') }}</h2>
    <table><thead><tr><th>{{ t('col_place') }}</th>{% if 'expired' in include %}<th class="n">{{ t('col_remove') }}</th>{% endif %}{% if 'soon' in include %}<th class="n">{{ t('col_soon') }}</th>{% endif %}{% if 'check' in include %}<th class="n">{{ t('col_check') }}</th>{% endif %}{% if 'unreferenced' in include %}<th class="n">{{ t('col_unref') }}</th>{% endif %}{% if for_print %}<th class="n">{{ t('col_page') }}</th>{% endif %}</tr></thead><tbody>
    {% for owner in versions %}{% for r in owner.rubrics %}<tr><td><a href="#{{ r.anchor }}"><span class="ver-tag">{{ t(owner.label) }}</span>{{ place(r.name) }}</a></td>
      {%- for key, name in (('remove', 'expired'), ('soon', 'soon'), ('check', 'check'), ('unreferenced', 'unreferenced')) %}{% if name in include %}<td class="n{{ ' hot' if key == 'remove' and r[key] }}">{% if r[key] %}{{ r[key] }}{% else %}<span class="zero">0</span>{% endif %}</td>{% endif %}{% endfor %}{{ pageno(r.anchor) }}</tr>{% endfor %}{% endfor %}
    </tbody></table>
  </section>
  {% else %}
  <p class="empty-note">{{ t('nothing') }}</p>
  {% endif %}

  {% for owner in versions %}
  <section class="version" id="{{ owner.anchor }}">
    <div class="vh"><h2>{{ t(owner.label) }}</h2><span>{{ owner.url }}</span></div>
    {% if owner.everywhere %}
    <div class="everywhere"><p><b>{{ t('everywhere_title') }}</b>{{ t('everywhere', n=everywhere_pages) }}</p>
      <div class="tiles">{% for item in owner.everywhere %}{{ unref(item) }}{% endfor %}</div></div>
    {% endif %}
    {% for r in owner.rubrics %}
    <div class="rubric" id="{{ r.anchor }}">
      <div class="rh"><h3>{{ place(r.name) }}</h3><span>{{ counts(r) }}</span>{% if for_print %}<span class="mk">{{ marker(r.anchor) }}</span>{% endif %}</div>
      {% for pg in r.pages %}
      <article class="pg">
        <header>{% if pg.url %}<a href="{{ pg.url }}">{{ pg.path }}</a>{% else %}<em>{{ t(pg.path) }}</em>{% endif %}<span>{% if pg.read_on %}{{ t('read_on', date=pg.read_on) }}{% endif %}</span></header>
        <div class="tiles">{% for row in pg.rows %}{{ tile(row) }}{% endfor %}{% for item in pg.unreferenced %}{{ unref(item) }}{% endfor %}</div>
      </article>
      {% endfor %}
    </div>
    {% endfor %}
  </section>
  {% endfor %}

  <footer>{{ t('footer_settings', settings=settings, when=site_read_on or t('unknown_date')) }}<br>{{ t('footer') }}</footer>
</body>
</html>
