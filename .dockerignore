# Built at image-build time by the frontend-builder stage; a stale host
# build would otherwise shadow it
frontend/dist
frontend/node_modules

# Not needed at runtime (README.md stays — pyproject.toml's readme field
# needs it present at `pip install .` time)
supabase/
docs/
tests/
backend/tests/
